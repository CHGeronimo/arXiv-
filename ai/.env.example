OPENAI_API_KEY=your-glm-api-key-here
# AI 供应商也可在前端 ⚙️ 设置面板直接选择/切换（GLM Coding Plan / GLM 按量 /
# DeepSeek / 自定义 OpenAI 兼容端点），验证通过后自动改写下面三项并即时生效；
# 各供应商的 Key 会分别记忆（PROVIDER_KEY_*），切换回来无需重填
# LLM_PROVIDER=glm_coding
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/
# MODEL_NAME=glm-5.3-flash
# Coding Plan 订阅用这个端点；按量付费 API 用 https://open.bigmodel.cn/api/paas/v4/
# DeepSeek 用 https://api.deepseek.com/v1 + deepseek-chat
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/
MODEL_NAME=glm-5.3-flash
LANGUAGE=Chinese

# 思考强度：auto（默认，按任务自动——预筛/提取/聚类关思考提速，评分/全文/趋势开思考）
# 可强制 on / off
# THINKING=auto

# 调度：自动爬取+AI分析每天凌晨 NIGHT_START 点起、每 STAGGER_MINUTES 分钟错峰一个任务
# （默认 2 点 / 30 分钟 → 02:00 arxiv, 02:30 crossref, 03:00 dblp, 03:30 s2, 04:00 author）；
# 手动触发（UI/API）不受限制。RUN_ON_START=1 则启动时立即先跑一轮。
# NIGHT_START=2
# STAGGER_MINUTES=30
# RUN_ON_START=0

# OpenAlex 全局节流（所有爬虫共享，避免并发触发 429）
# 填真实邮箱可进入 OpenAlex polite pool，限额更高
# OPENALEX_EMAIL=you@example.com
# OPENALEX_MIN_INTERVAL=1.2
# Crossref polite pool 联系邮箱（可选，不设则匿名请求）
# CROSSREF_EMAIL=you@example.com

# 本地零成本预筛：与研究方向零 token 重叠的论文直接拒，不进 LLM（省配额）
# LOCAL_FILTER=on
# AI 并行数（Coding Plan 并发有限，过高会 429）
# AI_MAX_WORKERS=5

# 引文顺藤摸瓜（锚点=must-read∪点赞论文，OpenAlex 免费，候选走常规漏斗）
# CITATION_ENABLED=on
# CITATION_ANCHORS_PER_RUN=10   # 每轮锚点数（72 锚点约 7 天轮换一圈）
# CITATION_MAX_PER_ANCHOR=15    # 每锚点引用/被引各取多少候选

# 监听地址（前端 ⚙️ 设置面板「🌐 监听地址」可改；命令行 --host/--port 优先级更高；重启 daemon 生效）
# DAEMON_HOST=127.0.0.1
# DAEMON_PORT=8080

# 可选：按任务覆盖模型（前端 ⚙️「🎛 按任务指定模型」面板直接管理；空 = 跟随 MODEL_NAME）
# 可用任务: quick_filter / keyword / topic / cluster / enhance / fulltext / trend / digest / knowledge / idea
# QUICK_FILTER_MODEL=glm-5.3-flash   # 快速相关性预筛
# KEYWORD_MODEL=glm-5.3-flash         # 关键词扩展/类别推荐
# TOPIC_MODEL=glm-5.3-flash           # feedback 主题提取/评语改写
# CLUSTER_MODEL=glm-5.3-flash         # 知识图谱聚类
# ENHANCE_MODEL=glm-5.3-flash         # 深度增强/评分
# FULLTEXT_MODEL=glm-5.3-flash        # 全文深读
# TREND_MODEL=glm-5.3-flash           # 周月趋势雷达
# DIGEST_MODEL=glm-5.3-flash          # 今日简报
# KNOWLEDGE_MODEL=glm-5.3-flash       # 知识卡片提取
# IDEA_MODEL=glm-5.3-flash            # 研究想法查重
